  "cards": [
    {
      "dot": "cyan",
      "title": "Why two planes and not one protocol",
      "items": [
        "An agent added once can use every plugin",
        "A plugin written once is usable by every agent",
        "Collapsing them into one protocol gives up both"
      ]
    },
    {
      "dot": "amber",
      "title": "The rule the renderer lives by",
      "items": [
        "No Node, no agent, no credentials in packages/ui",
        "It only ever talks to the host",
        "Enforced by script/check-layering.mjs, not by convention"
      ]
    }
  ]
