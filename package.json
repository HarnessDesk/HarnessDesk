{
  "name": "harnessdesk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "One desk for every coding agent: Codex, Claude Code, Cursor and DeepSeek Harness side by side on your own machine, with one history, one permission policy and one audit log.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HarnessDesk/HarnessDesk.git"
  },
  "homepage": "https://harnessdesk.app",
  "bugs": {
    "url": "https://github.com/HarnessDesk/HarnessDesk/issues"
  },
  "author": "HarnessDesk contributors",
  "keywords": [
    "coding-agent",
    "coding-agents",
    "agent-client-protocol",
    "acp",
    "codex",
    "claude-code",
    "cursor",
    "deepseek-harness",
    "gemini-cli",
    "multi-agent",
    "ai-agent",
    "agent-harness",
    "desktop-app",
    "electron",
    "macos",
    "local-first",
    "developer-tools",
    "mcp",
    "llm",
    "typescript"
  ],
  "packageManager": "pnpm@10.4.1",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "pnpm run build:node && pnpm --filter @harnessdesk/ui run build",
    "build:node": "tsc -b && node script/copy-fixtures.mjs",
    "clean": "tsc -b --clean && rm -rf packages/ui/dist",
    "typecheck": "tsc -b --noEmit && pnpm --filter @harnessdesk/ui run typecheck",
    "test": "pnpm run build:node && node --test --test-reporter=spec \"packages/*/dist/test/**/*.test.js\" && pnpm --filter @harnessdesk/ui run test && pnpm --filter @harnessdesk/desktop run test",
    "test:gates": "node --test \"script/*.test.mjs\" \"script/review/lib/*.test.mjs\"",
    "dev": "pnpm run build && pnpm --filter @harnessdesk/desktop run dev",
    "serve": "pnpm run build && node packages/server/dist/src/bin.js",
    "app": "pnpm run build && pnpm --filter @harnessdesk/desktop run start",
    "dist": "pnpm run build && pnpm --filter @harnessdesk/desktop run dist",
    "codex:protocol": "node script/generate-codex-protocol.mjs",
    "codex:drift": "node script/generate-codex-protocol.mjs --check",
    "verify": "node script/verify.mjs",
    "design:tokens": "node script/check-design-tokens.mjs",
    "design:audit": "node script/design-audit.mjs",
    "design:doc": "node script/design-doc.mjs",
    "design": "pnpm --filter @harnessdesk/ui run dev",
    "layering": "node script/check-layering.mjs",
    "icons": "node script/build-icons.mjs",
    "avatars": "node script/cut-avatars.mjs",
    "dsh:compare": "node script/dsh-compare.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "overrides": {
      "minimatch@>=10.0.0 <10.2.3": "^10.2.6",
      "fast-uri@>=3.0.0 <3.1.6": "^3.1.7",
      "qs@>=6.14.2 <6.16.0": "^6.16.0",
      "@xmldom/xmldom@>=0.9.0 <=0.9.11": "^0.9.12",
      "@xmldom/xmldom@>=0.7.0 <=0.8.14": "~0.8.15"
    }
  }
}
