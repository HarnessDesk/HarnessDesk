{
  "$schema": "https://json.schemastore.org/tsconfig",
  // The solution file: every Node package, once. `tsc -b` at the root builds
  // them in dependency order, and the build, clean and typecheck scripts all
  // read this list instead of carrying three copies of it. `packages/ui` is
  // not here — it is a Vite project with its own tsconfig, built and checked
  // by its own scripts — and `packages/desktop` is plain JavaScript.
  "files": [],
  "references": [
    { "path": "packages/protocol" },
    { "path": "packages/agent-inventory" },
    { "path": "packages/codex" },
    { "path": "packages/adapter-testkit" },
    { "path": "packages/cordis-host" },
    { "path": "packages/extension-protocol" },
    { "path": "packages/extension-host" },
    { "path": "packages/responses-gateway" },
    { "path": "packages/transport-acp" },
    { "path": "packages/adapter-acp" },
    { "path": "packages/cursor-acp" },
    { "path": "packages/claude-acp" },
    { "path": "packages/mcp-tools" },
    { "path": "packages/plugins" },
    { "path": "packages/adapter-codex" },
    { "path": "packages/server" }
  ]
}
